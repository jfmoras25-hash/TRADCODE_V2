{
  "name": "lsc-reconocimiento-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/preparar.mjs",
    "predev": "node scripts/preparar.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/preparar.mjs",
    "build": "tsc -b && vite build",
    "build:hibrido": "node scripts/preparar.mjs && tsc -b && vite build --mode hibrido --outDir dist-hibrido",
    "preview": "vite preview --host",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
